# Cycle Time (SLA) gadget — local configuration (copy to .env and fill in).
# .env is gitignored; nothing here is committed. The Forge CLI does NOT auto-load
# this file — `scripts/forge-env.sh` reads it to export APP_ID and push the
# runtime variables to Forge (`forge variables set`).

# --- Forge app identity -----------------------------------------------------
# Your registered Forge app id. Generate one with `forge register` (writes it
# here / to the app), or paste an existing app's id. Injected into manifest.yml
# as ${APP_ID} at deploy time.
APP_ID=ari:cloud:ecosystem::app/00000000-0000-0000-0000-000000000000

# --- Runtime variables (pushed to Forge via scripts/forge-env.sh) -----------
# Default Jira filter the gadget reads (a saved Jira filter id). The filter
# should select the resolved issues you want to measure, e.g.
#   resolution = Done AND assignee IS NOT EMPTY AND resolved >= -60d
# Also overridable per-gadget in the config UI; this is the fallback default.
CYCLE_TIME_FILTER_ID=

# Custom field ids on YOUR site (they vary per Jira instance — required). These
# are the two native JSM SLA fields the gadget reads, plus the "Request Type"
# field. Find them under Jira settings → Issues → Custom fields, or via the REST
# API (GET /rest/api/3/field). Example shape: customfield_XXXXX.
WAIT_SLA_FIELD=          # First Response SLA  (the "Wait" half)
EXEC_SLA_FIELD=          # Time to Resolution SLA (the "Execution" half)
REQUEST_TYPE_FIELD=      # JSM "Request Type" field

# Optional fallback JQL used only if the filter above can't be read. Leave blank
# to error out instead of guessing a query.
CYCLE_TIME_FALLBACK_JQL=

# --- Install targets (used by forge install commands; not read by the app) --
JIRA_SITE=your-site.atlassian.net
JIRA_CLOUD_ID=
